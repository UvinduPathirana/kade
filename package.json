{
  "name": "kade",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @kade/customer dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:restaurant": "pnpm --filter @kade/restaurant dev",
    "dev:rider": "pnpm --filter @kade/rider dev",
    "dev:admin": "pnpm --filter @kade/admin dev",
    "screenshots": "node scripts/screenshots.mjs",
    "proto:gen": "cd proto && buf generate && cd .. && pnpm --filter @kade/proto build",
    "proto:lint": "cd proto && buf lint",
    "infra:up": "docker compose -f deploy/compose/compose.yaml up -d",
    "infra:down": "docker compose -f deploy/compose/compose.yaml down"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "type": "module"
}
