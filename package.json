{
  "name": "kade",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @kade/customer dev",
    "build": "pnpm -r build",
