# Host run against the shared Compose stack. Copy to .env (git-ignored).
SERVICE_NAME=gateway-merchant
HTTP_PORT=8202
MERCHANT_GRPC=localhost:50109
CATALOG_GRPC=localhost:50101
REVIEW_GRPC=localhost:50115
LEDGER_GRPC=localhost:50113
PROMOTION_GRPC=localhost:50106
# Kitchen board pushes; /ws is proxied here when realtime answers (empty = polling only).
REALTIME_WS_URL=ws://localhost:8112/ws
KEYCLOAK_ISSUER=http://localhost:8080/realms/kade
# Tokens accepted from these Keycloak clients (azp claim).
KEYCLOAK_CLIENTS=merchant-app
CORS_ORIGINS=http://localhost:5175
# DEV ONLY: accept "Bearer dev:<userId>:<role,role>[:<outletId>]" without Keycloak. Refused unless DEPLOY_ENV=dev.
AUTH_DEV_BYPASS=true
DEPLOY_ENV=dev
# Outlet fallbacks while merchant's GetMyOutlets can't answer (username or user id = outlet id).
STAFF_OUTLETS=ruwan=00000000-0000-7000-8000-000000000001,kasun=00000000-0000-7000-8000-000000000001
DEFAULT_OUTLET_ID=00000000-0000-7000-8000-000000000001
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
