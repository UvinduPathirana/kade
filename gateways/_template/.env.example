# Host run against the shared Compose stack. Copy to .env (git-ignored).
SERVICE_NAME=gateway-template
HTTP_PORT=8200
TEMPLATE_GRPC=localhost:50100
KEYCLOAK_ISSUER=http://localhost:8080/realms/kade
# Tokens accepted from these Keycloak clients (azp claim). Real gateways: their app's client.
KEYCLOAK_CLIENTS=customer-app
CORS_ORIGINS=http://localhost:5174
# DEV ONLY: accept "Bearer dev:<userId>:<role,role>" without Keycloak. Refused unless DEPLOY_ENV=dev.
AUTH_DEV_BYPASS=true
DEPLOY_ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
