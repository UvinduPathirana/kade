# Host run against the shared Compose stack. Copy to .env (git-ignored).
SERVICE_NAME=gateway-admin
HTTP_PORT=8204
# Upstreams on the host (CONVENTIONS service registry). identity.v1 is served by profile.
ORDER_GRPC=localhost:50107
CATALOG_GRPC=localhost:50101
MERCHANT_GRPC=localhost:50109
PROFILE_GRPC=localhost:50103
PRICING_GRPC=localhost:50105
PROMOTION_GRPC=localhost:50106
LEDGER_GRPC=localhost:50113
DISPATCH_GRPC=localhost:50110
SUPPORT_GRPC=localhost:50116
# realtime (Go) WebSocket; leave unset until it runs.
# REALTIME_WS_URL=ws://localhost:8112/ws
KEYCLOAK_ISSUER=http://localhost:8080/realms/kade
# Tokens accepted from these Keycloak clients (azp claim).
KEYCLOAK_CLIENTS=admin-app
CORS_ORIGINS=http://localhost:5177
# DEV ONLY: accept "Bearer dev:<userId>:<role,role>" without Keycloak. Refused unless DEPLOY_ENV=dev.
AUTH_DEV_BYPASS=true
DEPLOY_ENV=dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
