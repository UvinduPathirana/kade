# Host run against the shared Compose stack. Copy to .env (git-ignored).
SERVICE_NAME=gateway-rider
HTTP_PORT=8203
DISPATCH_GRPC=localhost:50110
LOCATION_GRPC=localhost:50111
LEDGER_GRPC=localhost:50113
REVIEW_GRPC=localhost:50115
SUPPORT_GRPC=localhost:50116
# Offer and job pushes; /ws is proxied here when realtime answers (empty = polling only).
REALTIME_WS_URL=ws://localhost:8112/ws
KEYCLOAK_ISSUER=http://localhost:8080/realms/kade
# Tokens accepted from these Keycloak clients (azp claim).
KEYCLOAK_CLIENTS=rider-app
CORS_ORIGINS=http://localhost:5176
# DEV ONLY: accept "Bearer dev:<userId>:<role,role>" without Keycloak. Refused unless DEPLOY_ENV=dev.
AUTH_DEV_BYPASS=true
DEPLOY_ENV=dev
# Rider fallbacks while dispatch's GetMyRider can't answer (username or user id = rider id).
RIDER_IDS=nimal=00000000-0000-7000-8001-000000000101,00000000-0000-7000-8005-000000000004=00000000-0000-7000-8001-000000000101
DEFAULT_RIDER_ID=00000000-0000-7000-8001-000000000101
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
