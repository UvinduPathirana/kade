# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=pricing
GRPC_PORT=50105
HTTP_PORT=8105
DATABASE_URL=postgres://pricing:pricing@localhost:15432/pricing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Seconds-scale cache of the rule tables (ms); 0 = read every time.
RULES_CACHE_MS=2000
