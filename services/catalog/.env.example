# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=catalog
GRPC_PORT=50101
HTTP_PORT=8101
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Pricing (delivery fees for listings, zone of new locations). Optional: falls back to stored values.
PRICING_GRPC=localhost:50105
# Pin the Colombo time of day for opening hours in demos, e.g. 19:00. Unset = real time.
# DEMO_TIME=19:00
