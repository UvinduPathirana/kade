# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
# Ports: this laptop maps Postgres to 15432 (deploy/compose/.env); use 5432 if yours doesn't.
SERVICE_NAME=profile
GRPC_PORT=50103
HTTP_PORT=8103
DATABASE_URL=postgres://profile:profile@localhost:15432/profile
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Keycloak admin REST (phone sign-in provisions users and mints tokens through it).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=kade
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# dev = no SMS, every code is OTP_DEV_CODE; sms = random code via notification (NOTIFICATION_GRPC).
OTP_MODE=dev
OTP_DEV_CODE=123456
# Optional dependencies; leave unset when those services aren't running.
# PRICING_GRPC=localhost:50105
# NOTIFICATION_GRPC=localhost:50114
SEED_DEMO_DATA=true
