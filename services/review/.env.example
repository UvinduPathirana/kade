# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=review
GRPC_PORT=50115
HTTP_PORT=8115
DATABASE_URL=postgres://review:review@localhost:15432/review
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Fallback lookup when a rating arrives before OrderDelivered (optional).
ORDER_GRPC=localhost:50107
