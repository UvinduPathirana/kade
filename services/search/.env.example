# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=search
GRPC_PORT=50102
HTTP_PORT=8102
DATABASE_URL=postgres://search:search@localhost:5432/search
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# Catalog: backfill/rebuild of the projection (RebuildIndex, empty index on start). Optional.
CATALOG_GRPC=localhost:50101
# Pricing: delivery fees on results. Optional.
PRICING_GRPC=localhost:50105
# Pin the Colombo time of day for opening hours in demos, e.g. 19:00. Unset = real time.
# DEMO_TIME=19:00
