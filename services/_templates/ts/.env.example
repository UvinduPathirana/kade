# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=template-ts
GRPC_PORT=50100
HTTP_PORT=8100
DATABASE_URL=postgres://template_ts:template_ts@localhost:5432/template_ts
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
