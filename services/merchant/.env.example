# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=merchant
GRPC_PORT=50109
HTTP_PORT=8109
DATABASE_URL=postgres://merchant:merchant@localhost:15432/merchant
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug
# catalog gRPC for CreateRestaurant on approval (unset = skipped; catalog can use PartnerApplicationDecided)
CATALOG_GRPC=localhost:50101
SEED_DATA=true
DEMO_BOARD=true
HOUSEKEEPING_INTERVAL_MS=15000
