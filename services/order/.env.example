# Host run against the shared Compose stack (`pnpm infra:up`). Copy to .env (git-ignored).
SERVICE_NAME=order
GRPC_PORT=50107
HTTP_PORT=8107
# This laptop: Postgres is on 15432 (deploy/compose/.env).
DATABASE_URL=postgres://order:order@localhost:15432/orders
KAFKA_BROKERS=localhost:19092
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=kade
TEMPORAL_TASK_QUEUE=order
TEMPORAL_WORKER=true
ACCEPT_TIMEOUT_SECONDS=180

CATALOG_GRPC=localhost:50101
PROFILE_GRPC=localhost:50103
PRICING_GRPC=localhost:50105
PROMOTION_GRPC=localhost:50106
PAYMENT_GRPC=localhost:50108
# grpc | stub — stub answers in-process (README "Dependency modes").
CATALOG_MODE=grpc
PROFILE_MODE=grpc
PRICING_MODE=grpc
PROMOTION_MODE=stub
PAYMENT_MODE=stub
SEED_DEMO_ORDERS=true
