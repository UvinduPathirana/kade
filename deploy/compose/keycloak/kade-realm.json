{
  "realm": "kade",
  "displayName": "Kadé",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "bruteForceProtected": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 604800,
  "defaultRole": {
    "name": "default-roles-kade",
    "description": "Default roles",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "customer"
      ]
    }
  },
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Orders food"
      },
      {
        "name": "merchant_staff",
        "description": "Works an outlet's kitchen board"
      },
      {
        "name": "merchant_owner",
        "description": "Owns and configures a restaurant"
      },
      {
        "name": "rider",
        "description": "Delivers orders"
      },
      {
        "name": "ops",
        "description": "Operations console"
      },
      {
        "name": "finance",
        "description": "Payouts, ledger, reconciliation"
      },
      {
        "name": "support",
        "description": "Customer support tickets"
      },
      {
        "name": "admin",
        "description": "Platform administrator"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      }
    ]
  },
  "clients": [
