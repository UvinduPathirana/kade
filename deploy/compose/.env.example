# Copy to deploy/compose/.env (git-ignored) to override host ports on this machine.
# In-network addresses (postgres:5432, kafka:9092, ...) never change.
# POSTGRES_HOST_PORT=5432
# KAFKA_HOST_PORT=19092
# SCHEMA_REGISTRY_HOST_PORT=8085
# CONNECT_HOST_PORT=8083
# TEMPORAL_HOST_PORT=7233
# TEMPORAL_UI_HOST_PORT=8233
# KEYCLOAK_HOST_PORT=8080
# REDIS_HOST_PORT=6379
# GRAFANA_HOST_PORT=3000
# OTLP_GRPC_HOST_PORT=4317
# OTLP_HTTP_HOST_PORT=4318
# KAFKA_UI_HOST_PORT=8090
