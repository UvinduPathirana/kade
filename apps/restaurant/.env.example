# Copy to .env.local to override. Defaults shown.
# live: gateway-merchant + Keycloak sign-in (merchant-app). mock: in-browser services, no sign-in.
VITE_API_MODE=live
VITE_API_URL=http://localhost:8202
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/kade
VITE_OIDC_CLIENT_ID=merchant-app
# Keep some modules on the mock while their service is down, e.g. promotions,payouts,reviews
VITE_MOCK_MODULES=
