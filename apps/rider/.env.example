# Copy to .env.local to override. Defaults shown.
# live: gateway-rider + Keycloak sign-in (rider-app). mock: in-browser services, no sign-in.
VITE_API_MODE=live
VITE_API_URL=http://localhost:8203
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/kade
VITE_OIDC_CLIENT_ID=rider-app
# map: report the position on the illustrated map (works anywhere). device: the phone's real GPS.
VITE_RIDER_GPS=map
# Keep some modules on the mock while their service is down, e.g. payouts,support
VITE_MOCK_MODULES=
