# Customer app configuration (Vite). Copy to .env.local to override.
# live (default): the customer gateway + Keycloak sign-in. mock: the in-browser demo data.
VITE_API_MODE=live
VITE_API_URL=http://localhost:8201
VITE_KEYCLOAK_URL=http://localhost:8080/realms/kade
VITE_KEYCLOAK_CLIENT=customer-app
# DEV ONLY: skip Keycloak and call the gateway as this user (gateway needs AUTH_DEV_BYPASS=true).
# VITE_DEV_TOKEN=dev:00000000-0000-7000-8005-000000000001:customer
