# Kadé Ops console. Copy to .env.local to override (Vite reads VITE_* at dev/build time).
# live (default): gateway-admin + Keycloak sign-in. mock: the in-browser demo, no backend, no sign-in.
VITE_API_MODE=live
VITE_API_URL=http://localhost:8204
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/kade
VITE_OIDC_CLIENT_ID=admin-app
# DEV ONLY: skip Keycloak and send this gateway dev-bypass token (gateway needs AUTH_DEV_BYPASS=true).
# VITE_DEV_TOKEN=dev:00000000-0000-7000-8005-000000000005:ops
